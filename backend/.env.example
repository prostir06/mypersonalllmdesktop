PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llm_assistant
DB_USER=postgres
DB_PASSWORD=password

# Prisma (compose from DB_* if needed):
# postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/llm_assistant

# JWT — short access + opaque refresh cookie
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
# Deprecated (ignored): JWT_EXPIRE, JWT_REFRESH_LEEWAY_SEC

# 32-byte key for per-user secrets (openssl rand -base64 32)
ENCRYPTION_KEY=

# Registration gate (unset = allow outside production)
# ALLOW_REGISTRATION=false
# Shared process env keys. Unset = allow outside production.
# ALLOW_SHARED_PROVIDER_KEYS=false
# Daily USD cap for shared-key usage. A user's own key is not counted.
# Per-user override lives on users.shared_key_daily_limit_usd.
# SHARED_KEY_DAILY_LIMIT_USD=1
# Bootstrap admin. Unset = the first registered user.
# ADMIN_EMAIL=owner@example.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Gemini API key (can also be configured via Settings in UI)
GEMINI_API_KEY=

# Optional: Anthropic Claude API key (can also be configured via Settings in UI)
ANTHROPIC_API_KEY=

# Optional: Universal Web Search (SearXNG instance or Tavily API key)
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=

# Ollama (local or remote)
OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions
# Used only when a user has not chosen a model
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
OLLAMA_DEFAULT_MODEL=llama3.2
# Local RAG embeddings (when provider=ollama and no OpenAI key)
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
# Optional extra hostnames for Ollama SSRF allowlist (comma-separated)
# OLLAMA_URL_ALLOWLIST=ollama.lan,my-pc.local

# File Upload
MAX_FILE_SIZE=10485760
# Concurrent background document parse/embed jobs (in-process)
DOCUMENT_JOB_CONCURRENCY=2

# Parallel Ollama embedding HTTP calls during document index (1–16)
OLLAMA_EMBED_CONCURRENCY=4

# Max raw messages loaded before branch linearization for provider context
CHAT_HISTORY_RAW_CAP=500
# Pending indexing older than this (ms) is marked failed on list (default 10 min)
# DOCUMENT_INDEXING_STALE_MS=600000

# Postgres pool size for Prisma pg adapter (default 10)
# DB_POOL_MAX=10

# CORS
CORS_ORIGIN=http://localhost:3000
