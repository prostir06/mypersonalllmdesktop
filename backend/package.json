{
  "name": "llm-assistant-backend",
  "version": "1.0.0",
  "description": "Backend for personal LLM assistant control panel",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node -r ts-node/register\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=src/__tests__/integration --testPathIgnorePatterns=/node_modules/ --runInBand --forceExit",
    "lint": "eslint .",
    "audit:ci": "node scripts/audit-ci.cjs",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma/prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma/prisma.config.ts",
    "perf:baseline": "node -r ts-node/register scripts/perf-baseline.ts"
  },
  "keywords": [
    "llm",
    "assistant",
    "openai",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.5.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.9.1",
    "supertest": "^6.3.3",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "qs": "6.17.1",
    "uuid": "11.1.1"
  }
}
