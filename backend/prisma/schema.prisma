generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  settings         UserSettings?
  conversations    Conversation[]
  documents        Document[]
  llmModels        LlmModel[]
  refreshTokens    RefreshToken[]
  userPrompts      UserPrompt[]
  userMemoryNotes  UserMemoryNote[]
  pendingToolActions PendingToolAction[]

  @@map("users")
}

model UserSettings {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  defaultModel      String   @default("gpt-4o-mini") @map("default_model") @db.VarChar(255)
  defaultProvider   String   @default("openai") @map("default_provider") @db.VarChar(50)
  defaultOllamaHost String?  @default("http://127.0.0.1:11434/v1/chat/completions") @map("default_ollama_host") @db.VarChar(255)
  temperature       Decimal  @default(0.7) @db.Decimal(3, 2)
  maxTokens         Int      @default(2000) @map("max_tokens")
  systemPrompt      String   @default("") @map("system_prompt") @db.Text
  toolsEnabled      Boolean  @default(true) @map("tools_enabled")
  openaiApiKeyEnc   String?  @map("openai_api_key_enc") @db.Text
  geminiApiKeyEnc   String?  @map("gemini_api_key_enc") @db.Text
  anthropicApiKeyEnc String? @map("anthropic_api_key_enc") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_settings_user_id")
  @@map("user_settings")
}

model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String?  @db.VarChar(255)
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  summary               String?   @db.Text
  summaryUpdatedAt      DateTime? @map("summary_updated_at")
  messagesSinceSummary  Int       @default(0) @map("messages_since_summary")
  memoryNotes       ConversationMemoryNote[]

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           Message[]
  pendingToolActions PendingToolAction[]

  @@index([userId], map: "idx_conversations_user_id")
  @@index([userId, isPinned, updatedAt(sort: Desc)], map: "idx_conversations_user_pin_updated")
  @@index([userId, updatedAt(sort: Desc)], map: "idx_conversations_user_updated")
  @@map("conversations")
}

model ConversationMemoryNote {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  content        String   @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_memory_notes_conversation_id")
  @@map("conversation_memory_notes")
}

model UserMemoryNote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_memory_notes_user_id")
  @@map("user_memory_notes")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String   @db.VarChar(20)
  content        String   @db.Text
  sources        Json?    @map("sources")
  tokenUsage     Json?    @map("token_usage")
  toolTrace      Json?    @map("tool_trace")
  parentId       Int?     @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent             Message?            @relation("MessageBranches", fields: [parentId], references: [id], onDelete: Cascade)
  branches           Message[]           @relation("MessageBranches")
  pendingToolActions PendingToolAction[]

  @@index([conversationId], map: "idx_messages_conversation_id")
  @@index([conversationId, createdAt(sort: Asc)], map: "idx_messages_conv_created")
  @@index([parentId], map: "idx_messages_parent_id")
  @@map("messages")
}

model PendingToolAction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         Int          @map("user_id")
  conversationId Int          @map("conversation_id")
  messageId      Int          @map("message_id")
  toolName       String       @map("tool_name") @db.VarChar(100)
  toolArgs       Json         @map("tool_args")
  status         String       @default("pending") @db.VarChar(20)
  resultSummary  String?      @map("result_summary") @db.Text
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId])
  @@map("pending_tool_actions")
}

model UserPrompt {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(255)
  prompt    String   @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_prompts_user_id")
  @@map("user_prompts")
}

model LlmModel {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  name        String   @db.VarChar(255)
  modelId     String   @map("model_id") @db.VarChar(255)
  description String?  @db.Text
  provider    String   @default("openai") @db.VarChar(50)
  temperature Decimal  @default(0.7) @db.Decimal(3, 2)
  maxTokens   Int      @default(2000) @map("max_tokens")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_llm_models_user_id")
  @@index([provider], map: "idx_llm_models_provider")
  @@map("llm_models")
}

model Document {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  filename         String   @db.VarChar(255)
  fileType         String   @map("file_type") @db.VarChar(120)
  fileSize         Int      @map("file_size")
  status           String   @default("ready") @db.VarChar(20)
  failureReason    String?  @map("failure_reason") @db.VarChar(500)
  stagingPath      String?  @map("staging_path") @db.VarChar(512)
  embeddingsCount   Int      @default(0) @map("embeddings_count")
  embeddingProvider String?  @map("embedding_provider") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId], map: "idx_documents_user_id")
  @@map("documents")
}

model DocumentChunk {
  id         Int                         @id @default(autoincrement())
  documentId Int                         @map("document_id")
  chunkIndex Int                         @map("chunk_index")
  content    String                      @db.Text
  contentTsv Unsupported("tsvector")?    @map("content_tsv")
  createdAt  DateTime                    @default(now()) @map("created_at")
  embedding  Unsupported("vector(768)")?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex], map: "uq_document_chunks_doc_chunk")
  @@index([documentId], map: "idx_document_chunks_doc_id")
  @@map("document_chunks")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}
