{
  "name": "mypersonalllmdesktop-shell",
  "version": "1.0.0",
  "private": true,
  "description": "Electron shell for LLM Assistant Studio",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "test": "npm run build:ts && node --test dist/backendUrl.test.js dist/uiPaths.test.js dist/security.test.js dist/deepLinks.test.js dist/ipc.test.js dist/asyncFire.test.js dist/externalLinks.test.js",
    "dev": "npm run build:ts && cross-env ELECTRON_DEV=1 electron .",
    "start": "npm run build:ts && electron .",
    "pack": "npm run build:ts && electron-builder --dir",
    "pack:ci": "npm run build:ts && electron-builder --dir --linux",
    "dist": "npm run build:ts && electron-builder --win"
  },
  "build": {
    "appId": "com.mypersonalllmdesktop.app",
    "productName": "LLM Assistant Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/build",
        "to": "ui",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["dir"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": [
      {
        "name": "LLM Assistant Deep Link",
        "schemes": ["mypersonalllm"]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  }
}
