# Root env for Docker Compose (copy to `.env` — never commit secrets).
# Local/dev compose keeps soft defaults; production override requires real values.

# Required for production (`docker-compose.prod.yml`):
JWT_SECRET=
DB_PASSWORD=
# 32-byte key for AES-256-GCM API key encryption (e.g. `openssl rand -base64 32` or 64 hex chars):
ENCRYPTION_KEY=

# Strongly recommended when using OpenAI:
OPENAI_API_KEY=

# Optional: Google Gemini API key
GEMINI_API_KEY=

# Optional: Anthropic Claude API key
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional
DB_NAME=llm_assistant
DB_USER=postgres
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
# Registration: unset = allow outside production; false = always deny; true = always allow
# true|false; set true for local/CI E2E against Docker
ALLOW_REGISTRATION=true
# Shared process env keys. Unset = allow outside production.
# ALLOW_SHARED_PROVIDER_KEYS=false
# Daily USD cap for shared-key usage. A user's own key is not counted.
# SHARED_KEY_DAILY_LIMIT_USD=1
# Bootstrap admin. Unset = the first registered user.
# ADMIN_EMAIL=owner@example.com
OLLAMA_API_URL=http://host.docker.internal:11434/v1/chat/completions
# Used only when a user has not chosen a model
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
OLLAMA_DEFAULT_MODEL=llama3.2
SEARXNG_URL=http://searxng:8080
# Required in production (openssl rand -hex 32). Dev compose falls back to a local placeholder.
SEARXNG_SECRET=
# OLLAMA_URL_ALLOWLIST=
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=/api

# Dev-only defaults (used by plain `docker compose up`, not prod):
# NODE_ENV=development
# JWT_SECRET=change_this_secret_in_production
# DB_PASSWORD=password
