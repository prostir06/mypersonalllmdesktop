# Root env for Docker Compose (copy to `.env` — never commit secrets).
# Local/dev compose keeps soft defaults; production override requires real values.

# Required for production (`docker-compose.prod.yml`):
JWT_SECRET=
DB_PASSWORD=

# Strongly recommended when using OpenAI:
OPENAI_API_KEY=

# Optional
DB_NAME=llm_assistant
DB_USER=postgres
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
ENCRYPTION_KEY=
# Registration: unset = allow outside production; false = always deny; true = always allow
# ALLOW_REGISTRATION=false
OLLAMA_API_URL=http://host.docker.internal:11434/v1/chat/completions
# OLLAMA_URL_ALLOWLIST=
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=/api

# Dev-only defaults (used by plain `docker compose up`, not prod):
# NODE_ENV=development
# JWT_SECRET=change_this_secret_in_production
# DB_PASSWORD=password
